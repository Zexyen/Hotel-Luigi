{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Hotel Luigi",
  "repo": "Zexyen/Hotel-Luigi",
  "inputs": [
    {
      "id": "game",
      "label": "Your copy of Luigi's Mansion 3 (0100DCA0064A6000): its .xci or .nsp, or an extracted 1.4.0 dump (the folder with exefs and romfs inside).",
      "formats": [
        { "type": "folder" },
        { "type": "file", "extensions": ["xci", "nsp"], "requires": ["keys"] }
      ]
    },
    {
      "id": "update",
      "label": "With an .xci or .nsp: the 1.4.0 update (.nsp, v327680).",
      "role": "update",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"] }]
    },
    { "id": "keys", "label": "Your console's prod.keys", "role": "key", "shared": "switch.prod-keys" },
    {
      "id": "dlss",
      "label": "NVIDIA DLSS library (nvngx_dlss.dll, optional; for DLAA / DLSS upscaling on Windows RTX GPUs)",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["dll"] }]
    }
  ],
  "prepare": {
    "program": ["Hotel-Luigi-x86_64.AppImage", "build/hotel-luigi-game.exe", "build/hotel-luigi-game"],
    "args": ["--prepare", "--dump={input:game}", "--update={input:update}", "--keys={input:keys}"],
    "label": "Building the game from your dump",
    "done": ["{install}/build/built_version"],
    "keeps_copy": true
  },
  "start": {
    "program": ["Hotel-Luigi-x86_64.AppImage", "build/hotel-luigi-game.exe", "build/hotel-luigi-game"],
    "args": ["--play"]
  },
  "system": {
    "windows": { "version": "10", "graphics": { "vulkan": "1.3" } },
    "linux": { "glibc": "2.35", "graphics": { "vulkan": "1.3" } }
  },
  "exit_codes": {
    "0": "ok",
    "5": "The game's graphics couldn't start: it needs a GPU and driver with Vulkan 1.3. The log in Logs says what was missing."
  },
  "saves": ["{install}/build/userdata"],
  "folders": {
    "game": [{ "path": "{install}/targets" }],
    "saves": [{ "path": "{install}/build/userdata" }],
    "logs": [{ "path": "{install}/build/run" }],
    "mods": [{ "path": "{install}/mods" }]
  },
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save files.", "open": "saves" },
    { "id": "mods", "label": "Mods", "help": "Code mods (.pchtxt) and data mods. Changing a code mod rebuilds part of the game.", "open": "mods" },
    { "id": "logs", "label": "Logs", "help": "The game's log, for bug reports.", "open": "logs" }
  ],
  "config": [
    { "id": "main", "format": "ini", "file": [{ "path": "{install}/config/graphics.ini" }] },
    { "id": "controllers", "format": "ini", "file": [{ "path": "{install}/config/controllers.ini" }] }
  ],
  "settings": [
    {
      "id": "window", "label": "Display mode", "group": "Display",
      "help": "Windowed, or the monitor the window is on.",
      "choices": [
        { "label": "Windowed", "set": { "window": "windowed" } },
        { "label": "Borderless", "set": { "window": "borderless" } },
        { "label": "Fullscreen", "set": { "window": "fullscreen" } }
      ],
      "defaults": { "window": "windowed" }
    },
    {
      "id": "size", "label": "Window size", "group": "Display",
      "help": "The window in windowed mode.",
      "when": { "window": "windowed" },
      "choices": [
        { "label": "1280 × 720", "set": { "width": "1280", "height": "720" } },
        { "label": "1600 × 900", "set": { "width": "1600", "height": "900" } },
        { "label": "1920 × 1080", "set": { "width": "1920", "height": "1080" } },
        { "label": "2560 × 1440", "set": { "width": "2560", "height": "1440" } },
        { "label": "3840 × 2160", "set": { "width": "3840", "height": "2160" } }
      ],
      "defaults": { "width": "1280", "height": "720" }
    },
    {
      "id": "vsync", "label": "Vertical sync", "group": "Display",
      "help": "Auto locks to a 60, 120 or 240 Hz display. Off tears, for the lowest latency.",
      "choices": [
        { "label": "Auto", "set": { "vsync": "auto" } },
        { "label": "Display", "set": { "vsync": "display" } },
        { "label": "Clock", "set": { "vsync": "clock" } },
        { "label": "Off", "set": { "vsync": "off" } },
        { "label": "On", "set": { "vsync": "on" } },
        { "label": "Mailbox", "set": { "vsync": "mailbox" } }
      ],
      "defaults": { "vsync": "auto" }
    },
    {
      "id": "frame_rate", "label": "Frame rate", "group": "Display",
      "help": "30 is the game as made. Higher rates keep the game's speed the same.",
      "choices": [
        { "label": "30 fps", "set": { "frame_rate": "30" } },
        { "label": "40 fps", "set": { "frame_rate": "40" } },
        { "label": "60 fps", "set": { "frame_rate": "60" } },
        { "label": "90 fps", "set": { "frame_rate": "90" } },
        { "label": "120 fps", "set": { "frame_rate": "120" } },
        { "label": "144 fps", "set": { "frame_rate": "144" } },
        { "label": "165 fps", "set": { "frame_rate": "165" } },
        { "label": "240 fps", "set": { "frame_rate": "240" } }
      ],
      "defaults": { "frame_rate": "30" }
    },
    {
      "id": "frame_time_overlay", "label": "Performance overlay", "group": "Display",
      "help": "Frame rate and frame time at the top right of the picture.",
      "choices": [
        { "label": "Off", "set": { "frame_time_overlay": "off" } },
        { "label": "On", "set": { "frame_time_overlay": "on" } }
      ],
      "defaults": { "frame_time_overlay": "off" }
    },
    {
      "id": "resolution_scale", "label": "Internal resolution", "group": "Graphics",
      "help": "What the game renders at, times its own size. 1.0 is the console's.",
      "choices": [
        { "label": "0.4 ×", "set": { "resolution_scale": "0.4" } },
        { "label": "0.5 ×", "set": { "resolution_scale": "0.5" } },
        { "label": "0.6 ×", "set": { "resolution_scale": "0.6" } },
        { "label": "0.75 ×", "set": { "resolution_scale": "0.75" } },
        { "label": "0.8 ×", "set": { "resolution_scale": "0.8" } },
        { "label": "1.0 ×", "set": { "resolution_scale": "1.0" } },
        { "label": "1.2 ×", "set": { "resolution_scale": "1.2" } },
        { "label": "1.6 ×", "set": { "resolution_scale": "1.6" } },
        { "label": "2.0 ×", "set": { "resolution_scale": "2.0" } },
        { "label": "2.4 ×", "set": { "resolution_scale": "2.4" } },
        { "label": "3.0 ×", "set": { "resolution_scale": "3.0" } }
      ],
      "defaults": { "resolution_scale": "1.0" }
    },
    {
      "id": "upscaler", "label": "Upscaling", "group": "Upscaling",
      "help": "FSR 3.1, DLSS or FSR 4. Native AA smooths edges; Quality to Ultra Performance upscale to internal resolution (above 900p). DLAA, DLSS and FSR 4 need your own DLLs beside hotel-luigi-game.exe, else FSR 3.1 runs.",
      "choices": [
        { "label": "Off", "set": { "upscaler": "off" } },
        { "label": "FSR 3 Native AA", "set": { "upscaler": "fsr3" } },
        { "label": "FSR 3 Quality", "set": { "upscaler": "fsr3_quality" } },
        { "label": "FSR 3 Balanced", "set": { "upscaler": "fsr3_balanced" } },
        { "label": "FSR 3 Performance", "set": { "upscaler": "fsr3_performance" } },
        { "label": "FSR 3 Ultra Performance", "set": { "upscaler": "fsr3_ultra_performance" } },
        { "label": "DLAA", "set": { "upscaler": "dlaa" } },
        { "label": "DLSS Quality", "set": { "upscaler": "dlss_quality" } },
        { "label": "DLSS Balanced", "set": { "upscaler": "dlss_balanced" } },
        { "label": "DLSS Performance", "set": { "upscaler": "dlss_performance" } },
        { "label": "DLSS Ultra Performance", "set": { "upscaler": "dlss_ultra_performance" } },
        { "label": "FSR 4 Native AA", "set": { "upscaler": "fsr4" } },
        { "label": "FSR 4 Quality", "set": { "upscaler": "fsr4_quality" } },
        { "label": "FSR 4 Balanced", "set": { "upscaler": "fsr4_balanced" } },
        { "label": "FSR 4 Performance", "set": { "upscaler": "fsr4_performance" } },
        { "label": "FSR 4 Ultra Performance", "set": { "upscaler": "fsr4_ultra_performance" } }
      ],
      "defaults": { "upscaler": "off" }
    },
    {
      "id": "sharpness", "label": "Sharpness", "group": "Upscaling",
      "help": "Sharpens the picture after the upscaler. Needs Upscaling on.",
      "choices": [
        { "label": "Off", "set": { "sharpness": "0" } },
        { "label": "20 %", "set": { "sharpness": "20" } },
        { "label": "40 %", "set": { "sharpness": "40" } },
        { "label": "60 %", "set": { "sharpness": "60" } },
        { "label": "80 %", "set": { "sharpness": "80" } },
        { "label": "100 %", "set": { "sharpness": "100" } }
      ],
      "defaults": { "sharpness": "0" }
    },
    {
      "id": "frame_generation", "label": "Frame generation", "group": "Upscaling",
      "help": "Experimental, Windows. Generates a frame between every two game frames. Needs Upscaling on and your own DLLs beside hotel-luigi-game.exe.",
      "choices": [
        { "label": "Off", "set": { "frame_generation": "off" } },
        { "label": "On", "set": { "frame_generation": "on" } }
      ],
      "defaults": { "frame_generation": "off" }
    },
    {
      "id": "frame_generator", "label": "Frame generation: type", "group": "Upscaling",
      "help": "FSR (AMD FidelityFX DLLs) or DLSS (NVIDIA DLSSG DLL, RTX 40+).",
      "choices": [
        { "label": "FSR", "set": { "frame_generator": "fsr" } },
        { "label": "DLSS", "set": { "frame_generator": "dlss" } }
      ],
      "defaults": { "frame_generator": "fsr" }
    },
    {
      "id": "frame_generation_hud", "label": "Frame generation: HUD", "group": "Upscaling",
      "help": "Passes a HUD-less frame so UI stays sharp on generated frames. Turn off if the HUD flickers.",
      "choices": [
        { "label": "On", "set": { "frame_generation_hud": "on" } },
        { "label": "Off", "set": { "frame_generation_hud": "off" } }
      ],
      "defaults": { "frame_generation_hud": "on" }
    },
    {
      "id": "aspect_ratio", "label": "Picture shape", "group": "Graphics",
      "help": "Wider shows more at the sides. Auto is the screen's.",
      "choices": [
        { "label": "16:9", "set": { "aspect_ratio": "16:9" } },
        { "label": "Auto", "set": { "aspect_ratio": "auto" } },
        { "label": "21:9", "set": { "aspect_ratio": "21:9" } },
        { "label": "32:9", "set": { "aspect_ratio": "32:9" } }
      ],
      "defaults": { "aspect_ratio": "16:9" }
    },
    {
      "id": "aspect", "label": "Picture fit", "group": "Graphics",
      "help": "Keep the picture's shape, or fill the window.",
      "choices": [
        { "label": "Keep shape", "set": { "aspect": "keep" } },
        { "label": "Stretch", "set": { "aspect": "stretch" } }
      ],
      "defaults": { "aspect": "keep" }
    },
    {
      "id": "hud_area", "label": "HUD area", "group": "Graphics",
      "help": "With aspect_ratio wider than 16:9: screen puts the HUD at the edges, 16:9 keeps it in the middle.",
      "choices": [
        { "label": "Full screen", "set": { "hud_area": "screen" } },
        { "label": "Centered (16:9)", "set": { "hud_area": "16:9" } }
      ],
      "defaults": { "hud_area": "screen" }
    },
    {
      "id": "model_lod", "label": "Model detail", "group": "Graphics",
      "help": "Highest keeps every model at its finest detail at any distance. Weaker GPUs may lose frame rate.",
      "choices": [
        { "label": "As on the console", "set": { "model_lod": "game" } },
        { "label": "Highest", "set": { "model_lod": "highest" } }
      ],
      "defaults": { "model_lod": "game" }
    },
    {
      "id": "film_grain", "label": "Film grain", "group": "Graphics",
      "help": "The game's moving noise over the picture.",
      "choices": [
        { "label": "On", "set": { "film_grain": "on" } },
        { "label": "Off", "set": { "film_grain": "off" } }
      ],
      "defaults": { "film_grain": "on" }
    },
    {
      "id": "hdr", "label": "HDR", "group": "Graphics",
      "help": "Auto follows the desktop's HDR. Lights go above white.",
      "choices": [
        { "label": "Auto", "set": { "hdr": "auto" } },
        { "label": "Off", "set": { "hdr": "off" } },
        { "label": "On", "set": { "hdr": "on" } }
      ],
      "defaults": { "hdr": "auto" }
    },
    {
      "id": "hdr_paper_white", "label": "HDR white", "group": "Graphics", "advanced": true,
      "help": "The game's white with HDR on. Auto is the desktop's.",
      "choices": [
        { "label": "Auto", "set": { "hdr_paper_white": "auto" } },
        { "label": "100 nits", "set": { "hdr_paper_white": "100" } },
        { "label": "150 nits", "set": { "hdr_paper_white": "150" } },
        { "label": "200 nits", "set": { "hdr_paper_white": "200" } },
        { "label": "250 nits", "set": { "hdr_paper_white": "250" } },
        { "label": "300 nits", "set": { "hdr_paper_white": "300" } },
        { "label": "400 nits", "set": { "hdr_paper_white": "400" } }
      ],
      "defaults": { "hdr_paper_white": "auto" }
    },
    {
      "id": "hdr_peak", "label": "HDR peak", "group": "Graphics", "advanced": true,
      "help": "Your monitor's peak brightness, for the scene's lights.",
      "choices": [
        { "label": "Auto", "set": { "hdr_peak": "auto" } },
        { "label": "400 nits", "set": { "hdr_peak": "400" } },
        { "label": "600 nits", "set": { "hdr_peak": "600" } },
        { "label": "800 nits", "set": { "hdr_peak": "800" } },
        { "label": "1000 nits", "set": { "hdr_peak": "1000" } },
        { "label": "1500 nits", "set": { "hdr_peak": "1500" } },
        { "label": "2000 nits", "set": { "hdr_peak": "2000" } },
        { "label": "4000 nits", "set": { "hdr_peak": "4000" } }
      ],
      "defaults": { "hdr_peak": "auto" }
    },
    {
      "id": "button_prompts", "label": "Button prompts", "group": "Controls", "in": "controllers",
      "help": "Auto follows what you use.",
      "choices": [
        { "label": "Auto", "set": { "general/button_prompts": "auto" } },
        { "label": "PlayStation", "set": { "general/button_prompts": "playstation" } },
        { "label": "Xbox", "set": { "general/button_prompts": "xbox" } },
        { "label": "Switch", "set": { "general/button_prompts": "switch" } },
        { "label": "Keyboard", "set": { "general/button_prompts": "keyboard" } }
      ],
      "defaults": { "general/button_prompts": "auto" }
    },
    {
      "id": "swap_confirm", "label": "Swap confirm", "group": "Controls", "in": "controllers",
      "help": "The bottom button confirms and the right one goes back.",
      "choices": [
        { "label": "Off", "set": { "general/swap_confirm": "off" } },
        { "label": "On", "set": { "general/swap_confirm": "on" } }
      ],
      "defaults": { "general/swap_confirm": "off" }
    },
    {
      "id": "layout", "label": "Face buttons", "group": "Controls", "in": "controllers",
      "help": "Position uses Nintendo positions (right = A). Printed letter uses the controller's own labels.",
      "choices": [
        { "label": "Auto", "set": { "general/layout": "auto" } },
        { "label": "Position", "set": { "general/layout": "positional" } },
        { "label": "Printed letter", "set": { "general/layout": "labels" } }
      ],
      "defaults": { "general/layout": "auto" }
    },
    {
      "id": "language", "label": "Language", "group": "General",
      "help": "The game's language. Auto follows your system display language.",
      "choices": [
        { "label": "Auto", "set": { "language": "auto" } },
        { "label": "English (US)", "set": { "language": "en-US" } },
        { "label": "English (UK)", "set": { "language": "en-GB" } },
        { "label": "Spanish (Spain)", "set": { "language": "es" } },
        { "label": "Spanish (LatAm)", "set": { "language": "es-419" } },
        { "label": "French", "set": { "language": "fr" } },
        { "label": "French (Canada)", "set": { "language": "fr-CA" } },
        { "label": "German", "set": { "language": "de" } },
        { "label": "Italian", "set": { "language": "it" } },
        { "label": "Dutch", "set": { "language": "nl" } },
        { "label": "Japanese", "set": { "language": "ja" } },
        { "label": "Korean", "set": { "language": "ko" } },
        { "label": "Chinese (Simp.)", "set": { "language": "zh-Hans" } },
        { "label": "Chinese (Trad.)", "set": { "language": "zh-Hant" } }
      ],
      "defaults": { "language": "auto" }
    }
  ]
}
